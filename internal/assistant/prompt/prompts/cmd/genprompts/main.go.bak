// main.go
package main

import (
	"bytes"
	"go/format"
	"os"
	"text/template"
)

const headerText = `// Code generated by go generate; DO NOT EDIT.
package prompts

`

const templateText = `
func (p *{{.TypeName}}) Get{{.FieldName}}() {{.ReturnType}} {
	return p.{{.FieldName}}
}
`

type Data struct {
	TypeName   string
	FieldName  string
	ReturnType string
}

func main() {
	types := []string{
		"BasePrompts",
		"EditBlockPrompts",
		"EditBlockFunctionPrompts",
		"EditBlockFencedPrompts",
		"ArchitectPrompts",
		"AskPrompts",
		"EditorEditBlockPrompts",
		"EditorWholeFilePrompts",
		"SingleWholeFileFunctionPrompts",
		"WholeFilePrompts",
	}

	fields := map[string]string{
		"SystemReminder":                   "string",
		"FilesContentGPTEdits":             "string",
		"FilesContentGPTEditsNoRepo":       "string",
		"FilesContentGPTNoEdits":           "string",
		"FilesContentLocalEdits":           "string",
		"LazyPrompt":                       "string",
		"ExampleMessages":                  "[]Message",
		"FilesContentPrefix":               "string",
		"FilesContentAssistantReply":       "string",
		"FilesNoFullFiles":                 "string",
		"FilesNoFullFilesWithRepoMap":      "string",
		"FilesNoFullFilesWithRepoMapReply": "string",
		"RepoContentPrefix":                "string",
		"ReadOnlyFilesPrefix":              "string",
		"ShellCmdPrompt":                   "string",
		"ShellCmdReminder":                 "string",
		"NoShellCmdPrompt":                 "string",
		"NoShellCmdReminder":               "string",
	}
	var buf bytes.Buffer
	buf.WriteString(headerText)
	for _, typeName := range types {
		for fieldName, returnTypeName := range fields {
			tmpl := template.Must(template.New("methods").Parse(templateText))
			err := tmpl.Execute(
				&buf,
				Data{TypeName: typeName, FieldName: fieldName, ReturnType: returnTypeName},
			)
			if err != nil {
				panic(err)
			}
		}
	}

	// Format the code
	formatted, err := format.Source(buf.Bytes())
	if err != nil {
		panic(err)
	}

	// Write to a file
	err = os.WriteFile("generated_prompts.go", formatted, 0644)
	if err != nil {
		panic(err)
	}
}

